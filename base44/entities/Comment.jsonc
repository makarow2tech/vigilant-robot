{
  "name": "Comment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "body_cipher": {
      "type": "string",
      "description": "AES-256-GCM \u015fifreli yorum"
    },
    "envelopes": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "enumColors": [
        "green",
        "purple"
      ]
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "is_anon": {
      "type": "boolean"
    },
    "upvotes": {
      "type": "number"
    },
    "downvotes": {
      "type": "number"
    },
    "score": {
      "type": "number"
    },
    "depth": {
      "type": "number"
    },
    "is_removed": {
      "type": "boolean"
    }
  },
  "required": [
    "post_id",
    "body_cipher",
    "envelopes",
    "author_id",
    "author_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
