{
  "name": "SiteConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Ayar anahtar\u0131 (tek kay\u0131t: main)"
    },
    "site_name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "hero_title": {
      "type": "string"
    },
    "hero_subtitle": {
      "type": "string"
    },
    "announcement": {
      "type": "string"
    },
    "community_rules": {
      "type": "string"
    },
    "maintenance": {
      "type": "boolean"
    },
    "maintenance_text": {
      "type": "string"
    },
    "max_post_length": {
      "type": "number"
    },
    "allow_private_posts": {
      "type": "boolean"
    },
    "allow_attachments": {
      "type": "boolean"
    },
    "allow_new_topics": {
      "type": "boolean"
    },
    "allow_downvotes": {
      "type": "boolean"
    },
    "neon_hue": {
      "type": "number"
    },
    "neon2_hue": {
      "type": "number"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}