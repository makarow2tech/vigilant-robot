{
  "name": "AuthorSecret",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "G\u00f6nderi ya da yorum kimli\u011fi"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "post",
        "comment"
      ],
      "enumColors": [
        "blue",
        "pink"
      ]
    },
    "secret_hash": {
      "type": "string",
      "description": "Silme yetkisini do\u011frulayan hash \u2014 istemciye asla d\u00f6nmez"
    }
  },
  "required": [
    "record_id",
    "record_type",
    "secret_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}