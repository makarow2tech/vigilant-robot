{
  "name": "Vault",
  "type": "object",
  "properties": {
    "owner_key": {
      "type": "string",
      "description": "Taray\u0131c\u0131 anonim kimli\u011fi"
    },
    "public_key": {
      "type": "string",
      "description": "RSA-4096 a\u00e7\u0131k anahtar (JWK)"
    },
    "vault": {
      "type": "string",
      "description": "Parola ile sar\u0131lm\u0131\u015f \u00f6zel anahtar"
    }
  },
  "required": [
    "owner_key",
    "public_key",
    "vault"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}